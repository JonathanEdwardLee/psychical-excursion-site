{
  "name": "psychical-excursion",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Local-first installable web app foundation for Psychical Excursion.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "package:release": "node scripts/package-release.mjs",
    "verify:release": "bash scripts/verify-release-artifact.sh",
    "verify:canonical": "node scripts/verify-canonical-artifact.mjs",
    "verify:brand": "bash scripts/verify-brand-pwa.sh",
    "verify:privacy": "node scripts/verify-runtime-privacy.mjs",
    "test:publish": "bash scripts/test-publish-hostinger-deploy.sh",
    "report:release": "node scripts/report-release-tree.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  }
}
